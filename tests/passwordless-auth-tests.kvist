(package passwordless_auth_test)

(import auth "..")
(import strings "core:strings")
(import t "kvist:test")

(def Now-MS (i64 1790244000000))
(def Code-Key "a-test-only-otp-pepper-that-is-long")

(t.deftest secret-hashes-are-versioned-and-compatible
  (let [[plain plain-ok?] (auth.hash-secret "bearer")
        [keyed keyed-ok?] (auth.hash-secret-with-key "123456" "pepper")
        [legacy legacy-ok?] (auth.legacy-sha256-hex "bearer")]
    (defer (when plain-ok? (delete plain)))
    (defer (when keyed-ok? (delete keyed)))
    (defer (when legacy-ok? (delete legacy)))
    (t.is plain-ok?)
    (t.is keyed-ok?)
    (t.is legacy-ok?)
    (t.is (= (count plain) 53))
    (t.is (= (count keyed) 58))
    (t.is (= (count legacy) 64))
    (t.is (= plain
             "v1:sha256:JFStYcKswE8KIPq_fyvJbyjRnENAUv3v27UbRv5TT4k"))
    (t.is (= legacy
             "2454ad61c2acc04f0a20fabf7f2bc96f28d19c434052fdefdbb51b46fe534f89"))
    (t.is (auth.matches-secret? plain "bearer"))
    (t.is (not (auth.matches-secret? plain "wrong")))
    (t.is (auth.matches-secret-with-key? keyed "123456" "pepper"))
    (t.is (not (auth.matches-secret-with-key? keyed "123456" "wrong")))
    (t.is (auth.matches-secret? legacy "bearer"))))

(t.deftest hmac-format-matches-the-clojure-reference
  (let [[keyed ok?]
        (auth.hash-secret-with-key "123456" Code-Key)]
    (defer (when ok? (delete keyed)))
    (t.is ok?)
    (t.is (= keyed
             "v1:hmac-sha256:q00LtxJMyvo6Sz3WivnhdwlpEbYHiy8J-RHLNjJkBZU"))))

(t.deftest generated-credentials-have-safe-shapes
  (let [[first first-ok?] (auth.random-token)
        [second second-ok?] (auth.random-token)
        [code code-ok?] (auth.random-code)]
    (defer (when first-ok? (delete first)))
    (defer (when second-ok? (delete second)))
    (defer (when code-ok? (delete code)))
    (t.is first-ok?)
    (t.is second-ok?)
    (t.is code-ok?)
    (t.is (= (count first) 43))
    (t.is (!= first second))
    (t.is (= (count code) 6))
    (for [character (transmute []byte code)]
      (t.is (and (>= character (byte 48)) (<= character (byte 57))))))
  (let [[bad bad-ok?] (auth.random-code-with-digits 5)]
    (defer (when bad-ok? (delete bad)))
    (t.is (not bad-ok?))))

(t.deftest magic-link-is-issued-and-consumed-once
  (let [[issued issued?]
        (auth.issue-challenge
          (auth.Challenge-Issue-Options
            :id "challenge-1"
            :identity "CaseSensitiveIdentity"
            :method .Magic-Link
            :ttl-ms 0
            :digits 0
            :max-attempts 0
            :metadata "{:intent :sign-in}"
            :hash-key ""
            :now-ms Now-MS))]
    (t.is issued?)
    (when issued?
      (defer (auth.delete-issued-challenge! issued))
      (t.is (= issued.record.method .Magic-Link))
      (t.is (= issued.record.identity "CaseSensitiveIdentity"))
      (t.is (= issued.record.expires-at-ms (+ Now-MS 900000)))
      (t.is (= issued.record.max-attempts 1))
      (t.is (not (strings.contains issued.record.proof-hash issued.proof)))
      (let [[selector selected?]
            (auth.challenge-selector .Magic-Link "" issued.proof)]
        (defer (when selected? (delete selector)))
        (t.is selected?)
        (t.is (= selector issued.record.proof-hash)))
      (let [result
            (auth.verify-challenge
              (addr issued.record) .Magic-Link issued.proof "" Now-MS)]
        (defer (auth.delete-challenge-result! result))
        (t.is (= result.status .Verified))
        (t.is result.has-challenge?)
        (t.is (= result.challenge.identity "CaseSensitiveIdentity"))
        (t.is (= result.transition.op .Consume))
        (auth.apply-challenge-transition! (addr issued.record) result.transition))
      (let [again
            (auth.verify-challenge
              (addr issued.record) .Magic-Link issued.proof "" Now-MS)]
        (defer (auth.delete-challenge-result! again))
        (t.is (= again.status .Consumed))))))

(t.deftest code-failures-exhaust-the-attempt-budget
  (let [[issued issued?]
        (auth.issue-challenge
          (auth.Challenge-Issue-Options
            :id "challenge-2" :identity "user-1" :method .Code
            :ttl-ms 0 :digits 0 :max-attempts 2 :metadata ""
            :hash-key Code-Key :now-ms Now-MS))]
    (t.is issued?)
    (when issued?
      (defer (auth.delete-issued-challenge! issued))
      (let [first
            (auth.verify-challenge
              (addr issued.record) .Code "000000" Code-Key Now-MS)]
        (defer (auth.delete-challenge-result! first))
        (t.is (= first.status .Invalid-Proof))
        (t.is (= first.transition.failed-attempt-count 1))
        (auth.apply-challenge-transition! (addr issued.record) first.transition))
      (let [final
            (auth.verify-challenge
              (addr issued.record) .Code "000000" Code-Key Now-MS)]
        (defer (auth.delete-challenge-result! final))
        (t.is (= final.status .Attempts-Exhausted))
        (auth.apply-challenge-transition! (addr issued.record) final.transition))
      (let [locked
            (auth.verify-challenge
              (addr issued.record) .Code issued.proof Code-Key Now-MS)]
        (defer (auth.delete-challenge-result! locked))
        (t.is (= locked.status .Attempts-Exhausted))))))

(t.deftest challenge-expiry-is-exclusive
  (let [[issued issued?]
        (auth.issue-challenge
          (auth.Challenge-Issue-Options
            :id "challenge-3" :identity "user-1" :method .Magic-Link
            :ttl-ms 30000 :digits 0 :max-attempts 0 :metadata ""
            :hash-key "" :now-ms Now-MS))]
    (t.is issued?)
    (when issued?
      (defer (auth.delete-issued-challenge! issued))
      (let [result
            (auth.verify-challenge
              (addr issued.record) .Magic-Link issued.proof ""
              issued.record.expires-at-ms)]
        (defer (auth.delete-challenge-result! result))
        (t.is (= result.status .Expired))))))

(t.deftest session-lifecycle-hides-the-credential-hash
  (let [[issued issued?]
        (auth.issue-session
          (auth.Session-Issue-Options
            :id "session-1" :subject "user-42" :ttl-ms 1800000
            :metadata "{}" :now-ms Now-MS))]
    (t.is issued?)
    (when issued?
      (defer (auth.delete-issued-session! issued))
      (t.is (not (strings.contains issued.record.credential-hash
                                   issued.credential)))
      (let [active (auth.check-session (addr issued.record) Now-MS)]
        (defer (auth.delete-session-result! active))
        (t.is (= active.status .Active))
        (t.is active.has-session?)
        (t.is (= active.session.subject "user-42")))
      (let [expired
            (auth.check-session (addr issued.record)
                                issued.record.expires-at-ms)]
        (defer (auth.delete-session-result! expired))
        (t.is (= expired.status .Expired-Session)))
      (set! issued.record.revoked? true)
      (set! issued.record.revoked-at-ms Now-MS)
      (let [revoked (auth.check-session (addr issued.record) Now-MS)]
        (defer (auth.delete-session-result! revoked))
        (t.is (= revoked.status .Revoked-Session))))))

(t.deftest issuance-policy-has-stable-boundaries
  (t.is (auth.recommended-issuance-decision 4 19).allowed?)
  (let [identity-limited (auth.recommended-issuance-decision 5 0)
        client-limited (auth.recommended-issuance-decision 0 20)]
    (t.is (not identity-limited.allowed?))
    (t.is (= identity-limited.reason .Identity-Limit))
    (t.is (not client-limited.allowed?))
    (t.is (= client-limited.reason .Client-Limit))))
