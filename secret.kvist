(package passwordless_auth)

(import bit "kvist:bit")
(import crypto "core:crypto")
(import hash "core:crypto/hash")
(import hmac "core:crypto/hmac")
(import sha2 "core:crypto/sha2")
(import base64 "core:encoding/base64")
(import hex "core:encoding/hex")
(import fmt "core:fmt")
(import rand "core:math/rand")
(import str "kvist:str")
(import strings "core:strings")

(def SHA256-Prefix "v1:sha256:")
(def HMAC-SHA256-Prefix "v1:hmac-sha256:")

(defn- owned [value: string] -> string
  (let [[copy error] (strings.clone value)]
    (if (= error nil) copy "")))

(defn- owned-result [value: string] -> [copy: string, ok: bool]
  (let [[result error] (strings.clone value)]
    (if (= error nil)
      (return result true)
      (return "" false))))

(defn- id-or-random-uuid [id: string] -> [result: string, ok: bool]
  (if (= id "")
    (random-uuid)
    (owned-result id)))

(defn- sha256 [value: string] -> [32]byte
  (let [ctx (zero sha2.Context_256)
        digest ([32]byte [])]
    (sha2.init_256 (addr ctx))
    (sha2.update (addr ctx) (transmute []byte value))
    (sha2.final (addr ctx) (slice digest))
    digest))

(defn- hmac-sha256 [key: string, value: string] -> [32]byte
  (let [digest ([32]byte [])]
    (hmac.sum .SHA256 (slice digest)
              (transmute []byte value) (transmute []byte key))
    digest))

(defn- base64url-no-padding [bytes: []byte] -> [encoded: string, ok: bool]
  (let [[padded error] (base64.encode bytes base64.ENC_URL_TABLE)]
    (when (!= error nil) (return "" false))
    (defer (delete padded))
    (let [end (cond
                (str.ends-with? padded "==") (- (count padded) 2)
                (str.ends-with? padded "=") (- (count padded) 1)
                :else (count padded))]
      (return (owned (slice padded 0 end)) true))))

(defn- valid-base64url? [value: string] -> bool
  (for [character (transmute []byte value)]
    (when (not (or (and (>= character (byte 65)) (<= character (byte 90)))
                   (and (>= character (byte 97)) (<= character (byte 122)))
                   (and (>= character (byte 48)) (<= character (byte 57)))
                   (= character (byte 45))
                   (= character (byte 95))))
      (return false)))
  true)

(defn- decode-base64url [value: string] -> [decoded: []byte, ok: bool]
  (when (or (not (valid-base64url? value)) (= (% (count value) 4) 1))
    (return nil false))
  (let [remainder (% (count value) 4)
        padded (case remainder
                 0 (owned value)
                 2 (fmt.aprintf "%s==" value)
                 3 (fmt.aprintf "%s=" value)
                 (owned ""))]
    (defer (delete padded))
    (let [[bytes error] (base64.decode padded base64.DEC_URL_TABLE)]
      (if (= error nil)
        (return bytes true)
        (return nil false)))))

(defn- versioned-hash [prefix: string, digest: []byte]
  -> [encoded: string, ok: bool]
  (let [[body encoded?] (base64url-no-padding digest)]
    (when (not encoded?) (return "" false))
    (defer (delete body))
    (return (fmt.aprintf "%s%s" prefix body) true)))

(defn hash-secret [value: string] -> [encoded: string, ok: bool]
  (let [digest (sha256 value)]
    (versioned-hash SHA256-Prefix (slice digest))))

(defn hash-secret-with-key [value: string, key: string]
  -> [encoded: string, ok: bool]
  (when (= (count key) 0) (return "" false))
  (let [digest (hmac-sha256 key value)]
    (versioned-hash HMAC-SHA256-Prefix (slice digest))))

(defn legacy-sha256-hex [value: string] -> [encoded: string, ok: bool]
  (let [digest (sha256 value)
        [bytes error] (hex.encode (slice digest))]
    (if (= error nil)
      (return (transmute string bytes) true)
      (return "" false))))

(defn- lowercase-hex? [value: string] -> bool
  (when (!= (count value) 64) (return false))
  (for [character (transmute []byte value)]
    (when (not (or (and (>= character (byte 48)) (<= character (byte 57)))
                   (and (>= character (byte 97)) (<= character (byte 102)))))
      (return false)))
  true)

(defn- hash-body [stored: string, prefix: string] -> string
  (if (and (str.starts-with? stored prefix)
           (= (count stored) (+ (count prefix) 43)))
    (slice stored (count prefix))
    ""))

(defn matches-secret? [stored: string, value: string] -> bool
  (let [body (hash-body stored SHA256-Prefix)]
    (when (!= body "")
      (let [[expected decoded?] (decode-base64url body)]
        (defer (when decoded? (delete expected)))
        (when decoded?
          (let [actual (sha256 value)]
            (return (= (crypto.compare_constant_time expected (slice actual)) 1)))))))
  (when (lowercase-hex? stored)
    (let [[actual encoded?] (legacy-sha256-hex value)]
      (defer (when encoded? (delete actual)))
      (return (and encoded?
                   (= (crypto.compare_constant_time
                        (transmute []byte stored)
                        (transmute []byte actual)) 1)))))
  false)

(defn matches-secret-with-key? [stored: string, value: string, key: string]
  -> bool
  (let [body (hash-body stored HMAC-SHA256-Prefix)]
    (when (or (= body "") (= key "")) (return false))
    (let [[expected decoded?] (decode-base64url body)]
      (defer (when decoded? (delete expected)))
      (when (not decoded?) (return false))
      (let [actual (hmac-sha256 key value)]
        (= (crypto.compare_constant_time expected (slice actual)) 1)))))

(defn random-token-with-bytes [byte-count: int] -> [token: string, ok: bool]
  (when (or (< byte-count 16) (> byte-count 1024))
    (return "" false))
  (let [bytes (make []byte byte-count)]
    (defer (delete bytes))
    (crypto.rand_bytes bytes)
    (base64url-no-padding bytes)))

(defn random-token [] -> [token: string, ok: bool]
  (random-token-with-bytes 32))

(defn random-code-with-digits [digits: int] -> [code: string, ok: bool]
  (when (or (< digits 6) (> digits 9))
    (return "" false))
  (let [bound 1
        index 0]
    (while (< index digits)
      (set! bound (* bound 10))
      (inc! index))
    (let [generator (crypto.random_generator)
          value (rand.int_max bound generator)]
      (return (fmt.aprintf "%0*d" digits value) true))))

(defn random-code [] -> [code: string, ok: bool]
  (random-code-with-digits 6))

(defn random-uuid [] -> [id: string, ok: bool]
  (let [bytes ([16]byte [])]
    (crypto.rand_bytes (slice bytes))
    (set! bytes[6] (bit.or (bit.and bytes[6] (byte 15)) (byte 64)))
    (set! bytes[8] (bit.or (bit.and bytes[8] (byte 63)) (byte 128)))
    (let [[encoded error] (hex.encode (slice bytes))]
      (when (!= error nil) (return "" false))
      (defer (delete encoded))
      (let [text (string encoded)]
        (return
          (fmt.aprintf "%s-%s-%s-%s-%s"
            (slice text 0 8) (slice text 8 12) (slice text 12 16)
            (slice text 16 20) (slice text 20 32))
          true)))))
